rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.SuperAdmin == true;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin(request.auth.uid));
      allow list: if isSuperAdmin(request.auth.uid);
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin(request.auth.uid));
    }

    match /spaces/{spaceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.createdBy || isSuperAdmin(request.auth.uid));
    }

    match /favorites/{favoriteId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
