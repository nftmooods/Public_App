rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is a Super Admin
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    // --- Users Collection ---
    // Rules for accessing user profiles.
    match /users/{userId} {
      // Allow reading a profile if:
      // 1. You are the owner of the profile.
      // 2. You are a Super Admin.
      allow get: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      
      // Allow listing all users ONLY if you are a Super Admin.
      allow list: if request.auth != null && isSuperAdmin();

      // Allow writing to a profile if:
      // 1. You are the owner (for self-updates).
      // 2. You are a Super Admin (for managing roles like isHost, isCertified, etc.).
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // --- Spaces Collection ---
    // Rules for events/spaces.
    match /spaces/{spaceId} {
      // Anyone can read events.
      allow read: if true;
      
      // Any authenticated user can create a new space.
      allow create: if request.auth != null;
      
      // Allow update/delete if:
      // 1. You are the creator of the space.
      // 2. You are a Super Admin.
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.createdBy || isSuperAdmin());
    }

    // --- Favorites Collection ---
    // Rules for managing favorites.
    match /favorites/{favoriteId} {
      // Allow reading for everyone to count likes.
      allow read: if true;
      
      // Allow creating a favorite ONLY if you are the one creating it.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Allow deleting a favorite ONLY if you are the one who created it.
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
