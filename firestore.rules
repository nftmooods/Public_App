
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of a document
    function isOwner(resource) {
      return request.auth.uid == resource.data.createdBy;
    }

    // Users: can only manage their own profile
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }

    // Spaces:
    // - Anyone can read the list of spaces.
    // - Only authenticated users can create a new space.
    // - Only the owner of a space can update or delete it.
    match /spaces/{spaceId} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow update, delete: if isOwner(get(/databases/$(database)/documents/spaces/$(spaceId)));
    }

    // Favorites:
    // - Users can only manage their own list of favorites.
    match /favorites/{favoriteId} {
      allow read, create, delete: if request.auth.uid == request.resource.data.userId;
    }
  }
}
