rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read their own profile and admins can read any profile.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || request.auth.token.admin == true;
      allow write: if request.auth.uid == userId; // Users can update their own profile
      // Allow public read of all user documents for name searching
      allow list: if request.auth != null;
    }

    // Spaces can be read by anyone who is authenticated.
    match /spaces/{spaceId} {
      allow read: if true;
      
      // Create: User must be logged in.
      allow create: if request.auth != null;
      
      // Update: User must be the creator OR a SuperAdmin.
      // This rule allows the creator to re-assign ownership.
      allow update: if request.auth.uid == resource.data.createdBy || request.auth.token.admin == true;

      // Delete: Only the creator or a SuperAdmin can delete a space.
      allow delete: if request.auth.uid == resource.data.createdBy || request.auth.token.admin == true;
    }

    // Favorites can be managed by the user who owns them.
    match /favorites/{favoriteId} {
      allow read, create: if request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth.uid == resource.data.userId;
      // Allow users to list their own favorites
       allow list: if request.auth != null && request.auth.uid == request.query.where.userId;
    }
  }
}
