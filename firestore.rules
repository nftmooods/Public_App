
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isSuperAdmin() {
      return request.auth.token.admin == true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Anyone can create a user profile (on signup)
      allow create: if request.auth != null;
      // Only the authenticated user can read or update their own profile
      allow read, update: if request.auth.uid == userId;
      // No one can delete user profiles for now
      allow delete: if false;
    }

    // --- Spaces Collection ---
    match /spaces/{spaceId} {
      // Anyone can read the list of spaces
      allow read: if true;
      // A user must be logged in to create a space
      allow create: if request.auth != null;

      // UPDATE rules:
      // 1. A SuperAdmin can update any document.
      // 2. The original creator of the event can update it. This allows them
      //    to transfer ownership by changing the 'createdBy' field, because
      //    at the time of the request, they are still the owner according
      //    to the existing document data (`resource.data`).
      allow update: if isSuperAdmin() || request.auth.uid == resource.data.createdBy;

      // DELETE rules:
      // Only the event creator or a SuperAdmin can delete an event.
      allow delete: if isSuperAdmin() || request.auth.uid == resource.data.createdBy;
    }
    
    // --- Favorites Collection ---
    match /favorites/{favoriteId} {
        // Any authenticated user can create a favorite record for themselves.
        allow create: if request.auth.uid == request.resource.data.userId;
        // Users can only read or delete their own favorite records.
        allow read, delete: if request.auth.uid == resource.data.userId;
    }
  }
}

    