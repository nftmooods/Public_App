rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Checks if a user has the SuperAdmin field set to true in their user document.
    function isSuperAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.SuperAdmin == true;
    }

    // Users can only read/write their own document. SuperAdmins can read/write any document.
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isSuperAdmin(request.auth.uid));
      allow list: if request.auth != null && isSuperAdmin(request.auth.uid);
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin(request.auth.uid));
    }

    // Spaces can be read by anyone.
    // Logged-in users can create spaces.
    // Only the creator or a SuperAdmin can update or delete a space.
    match /spaces/{spaceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
                                (request.auth.uid == resource.data.createdBy || isSuperAdmin(request.auth.uid));
    }

    // Users can only manage their own favorites.
    // Reading favorites is public to allow counting likes.
    match /favorites/{favoriteId} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
