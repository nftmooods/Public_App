
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    
    // Helper function to check if the user is the owner of a document
    function isOwner(docData) {
      return request.auth.uid == docData.createdBy;
    }

    // Users collection rules
    match /users/{userId} {
      // Anyone can create a user profile (on sign up)
      allow create: if request.auth.uid == userId;
      // Only the authenticated user can read their own profile
      allow read: if request.auth.uid == userId;
      // Only the authenticated user can update their own profile
      allow update: if request.auth.uid == userId;
      // Users cannot delete their profiles for now
      allow delete: if false;
    }

    // Spaces collection rules
    match /spaces/{spaceId} {
      // Any authenticated user can create a space
      allow create: if request.auth.uid != null;
      // Anyone can read spaces
      allow read: if true;
      // An admin can update any space.
      // A standard user can only update a space they created, AND they cannot change the owner.
      allow update: if isAdmin() || (isOwner(resource.data) && request.resource.data.createdBy == resource.data.createdBy);
      // Only the owner or an admin can delete a space
      allow delete: if isAdmin() || isOwner(resource.data);
    }

    // Favorites collection rules
    match /favorites/{favoriteId} {
        // A user can create a favorite only for themselves
        allow create: if request.resource.data.userId == request.auth.uid;
        // Anyone can read favorites (might want to restrict this later)
        allow read: if true;
        // A user can only update/delete their own favorites
        allow update, delete: if resource.data.userId == request.auth.uid;
    }
  }
}
