rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      // Check if the user making the request has the SuperAdmin field set to true in their user document.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.SuperAdmin == true;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow get: if the user is fetching their own document, OR if the user is a SuperAdmin.
      allow get: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      
      // Allow list: Only SuperAdmins can list all users.
      allow list: if request.auth != null && isSuperAdmin();
      
      // Allow write (create, update): if the user is writing to their own document, OR if the user is a SuperAdmin.
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // Rules for the 'spaces' collection
    match /spaces/{spaceId} {
      allow read: if true;
      allow create: if request.auth != null;
      
      // Allow update/delete: if the user is the creator of the space, OR if the user is a SuperAdmin.
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.createdBy || isSuperAdmin());
    }

    // Rules for the 'favorites' collection
    match /favorites/{favoriteId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
