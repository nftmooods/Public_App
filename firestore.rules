rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // SuperAdmin Catch-all: Permet l'accès complet (lecture/écriture) à tout document
    // si l'utilisateur connecté a la custom claim SuperAdmin: true.
    // Cette règle est évaluée en premier.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.SuperAdmin == true;
    }

    // Règles plus spécifiques (s'appliquent si l'utilisateur n'est PAS un SuperAdmin)

    // Users: read/write own, SuperAdmins get/list/write all
    match /users/{userId} {
      // Les SuperAdmins sont couverts par la règle catch-all pour get/list/write.
      // Ces règles s'appliquent aux utilisateurs connectés NON SuperAdmins.
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false; // Non-SuperAdmins ne peuvent pas lister tous les users
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Spaces: read all, create if logged in, update/delete if creator OR SuperAdmin
    match /spaces/{spaceId} {
      // Les SuperAdmins sont couverts par la règle catch-all pour read/create/update/delete.
      // Ces règles s'appliquent aux utilisateurs non SuperAdmins.
      allow read: if true; // Tout le monde peut lire
      allow create: if request.auth != null; // Tout connecté peut créer
      // L'auteur peut modifier/supprimer. Les SuperAdmins aussi via la règle catch-all.
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Favorites: read all, manage own
    match /favorites/{favoriteId} {
      // Les SuperAdmins sont couverts par la règle catch-all pour read/delete/create.
      // Ces règles s'appliquent aux utilisateurs non SuperAdmins.
      allow read: if true; // Tout le monde peut lire pour compter les likes
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId; // Seul le propriétaire peut supprimer
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId; // Seul le propriétaire peut créer
    }
  }
}
